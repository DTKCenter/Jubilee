class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/d0b2d18bd0b5d0b7d0b420d0bdd0b020d0bfd180d0b8d180d0bed0b4d18320d0bdd0b020d0b1d0b8d0b1d0bbd0b8d0bed182d0b5d0ba202025-1256x942.jpg\" alt=\"Mobirise Website Builder\">\n                    <p class=\"mbr-text mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-text\">День библиотек с ветеранами, 2024 г.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/d18120d0b2d0b5d182d0b5d180d0b0d0bdd0b0d0bcd0b820d0a6d094d0ae20202420d0b3.20d094d0b5d0bdd18c20d0bfd0bed0b6d0b8d0bbd18bd18520d0bbd18ed0b4d0b5d0b9-1256x1063.jpg\" alt=\"Mobirise Website Builder\">\n                    <p class=\"mbr-text mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-text\">День добра и уважения с ветеранами, 2023 г.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
